# IDLE's general default settings.
#
# Do not edit this file: it is replaced on upgrades.  Settings changed in
# the Settings dialog are stored in ~/.idlerc/config-main.cfg, which
# overrides the values given here.
#
# [General]  editor-on-startup: open an editor instead of the shell;
#            autosave: save without asking before Run Module;
#            print-command-*: shell command used to print a file (%%s is
#            the file name; a literal % must be written %%).
# [EditorWindow]  initial window size (characters/lines) and font.
# [PyShell]  auto-squeeze-min-lines: output blocks with at least this many
#            lines are collapsed into a button.
# [Indent]   use-spaces and num-spaces for new files.
# [Theme], [Keys]  the color theme and key set in use: with default = 1 a
#            built-in one named by name2 (or name), otherwise a user one.
# [History]  cyclic: whether shell history wraps around.
# [HelpFiles]  additional help sources, "N = menu item;path or URL".

[General]
editor-on-startup= 0
autosave= 0
print-command-posix=lpr %%s
print-command-win=start /min notepad /p %%s
delete-exitfunc= 1

[EditorWindow]
width= 80
height= 40
cursor-blink= 1
font= TkFixedFont
font-size= 10
font-bold= 0
encoding= none
line-numbers-default= 0

[PyShell]
auto-squeeze-min-lines= 50

[Indent]
use-spaces= 1
num-spaces= 4

[Theme]
default= 1
name= IDLE Classic
name2=

[Keys]
default= 1
name=
name2=

[History]
cyclic=1

[HelpFiles]
